{
  "manifest_version": 3,
  "name": "mdREADER",
  "version": "8.3.0",
  "description": "Lecteur Markdown élégant : thèmes, sommaire, coloration syntaxique, actualisation auto, impression A4.",
  "author": "Abricot Labs",
  "homepage_url": "https://github.com/cheezelcom/mdreader",
  "permissions": [
    "storage"
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.MD",
        "file:///*.markdown",
        "file:///*.mdown",
        "file:///*.mkd",
        "http://localhost/*.md",
        "http://127.0.0.1/*.md",
        "https://raw.githubusercontent.com/*.md"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://raw.githubusercontent.com/*"
      ]
    }
  ]
}
